# Local Docker development — test credentials (see README "Docker (local)").
# Do not use these values in production.

PORT=3000
NODE_ENV=development
LOG_LEVEL=debug

# Admin (created on first startup)
ADMIN_USERNAME=admin.local
ADMIN_PASSWORD=Admin123!
ADMIN_EMAIL=admin@local.dev
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=LOCAL

# Company details (PDF headers, etc.)
COMPANY_NAME=VIRGA Demo Garage
COMPANY_ADDRESS=1 rue du Test, 75000 Paris
COMPANY_PHONE=01 23 45 67 89
COMPANY_EMAIL=contact@local.dev

# Security
SESSION_SECRET=local-docker-dev-secret-not-for-production
BCRYPT_SALT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=4
LOCK_TIME=15

# Instance metadata (required by app.js)
INSTANCE_ID=local-docker
DOMAIN=localhost

# Seed secretary + mechanic test accounts on first startup
SEED_TEST_USERS=true
SECRETARY_USERNAME=secretary.local
SECRETARY_PASSWORD=Secretary123!
SECRETARY_EMAIL=secretary@local.dev
SECRETARY_FIRST_NAME=Marie
SECRETARY_LAST_NAME=SECRETAIRE
MECHANIC_USERNAME=mechanic.local
MECHANIC_PASSWORD=Mechanic123!
MECHANIC_EMAIL=mechanic@local.dev
MECHANIC_FIRST_NAME=Jean
MECHANIC_LAST_NAME=MECANICIEN
