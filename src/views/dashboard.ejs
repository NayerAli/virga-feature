  <!-- Main Content -->
  <section class="reports-section">
    <div class="section-header">
      <h3><i class="fas fa-car"></i> Rapports Récents</h3>
      <div class="header-actions">
        <div class="search-box flex items-center bg-white p-1 rounded-lg md:min-w-[400px]">
          <i class="fas fa-search text-gray-500"></i>
          <input type="text" id="searchReports" placeholder="Rechercher plaque, client, marque..." value="<%= typeof search !== 'undefined' ? search : '' %>">
        </div>
      </div>
    </div>

    <div class="table-responsive">
      <table class="reports-table">
        <thead>
          <tr>
            <th>
              <i class="fas fa-id-card"></i>
              Immatriculation
            </th>
            <th>
              <i class="fas fa-user"></i>
              Client
            </th>
            <th>
              <i class="fas fa-car"></i>
              Véhicule
            </th>
            <th>
              <i class="fas fa-calendar"></i>
              Date
            </th>
            <th>
              <i class="fas fa-cog"></i>
              Actions
            </th>
          </tr>
        </thead>
        <tbody>
          <% if (reports && reports.length > 0) { %>
            <% reports.forEach(function(report) { %>
              <tr class="report-row">
                <td class="license-plate"><%= report.license_plate %></td>
                <td><%= report.client_name %></td>
                <td>
                  <% const dashboardBrandLogo = getVehicleBrandLogo(report.brand); %>
                  <div class="vehicle-brand-cell">
                    <img src="<%= dashboardBrandLogo.src %>"
                         alt="<%= dashboardBrandLogo.alt %>"
                         class="vehicle-brand-logo vehicle-brand-logo-sm"
                         loading="lazy"
                         decoding="async">
                    <span><%= report.brand && report.model ? `${report.brand} ${report.model}` : 'N/A' %></span>
                  </div>
                </td>
                <td><%= new Date(report.created_at).toLocaleDateString('fr-FR') %></td>
                <td>
                  <div class="action-buttons">
                    <a href="/report/<%= report.report_id %>" 
                       class="action-btn view" 
                       title="Voir le rapport">
                      <i class="fas fa-eye"></i>
                    </a>
                    <a href="/report/preview/<%= report.report_id %>?fresh=<%= Date.now() %>"
                       class="action-btn preview" 
                       title="Prévisualiser PDF"
                       target="_blank">
                      <i class="fas fa-file-pdf"></i>
                    </a>
                    <a href="/report/download/<%= report.report_id %>?fresh=<%= Date.now() %>"
                       class="action-btn download" 
                       title="Télécharger">
                      <i class="fas fa-download"></i>
                    </a>
                    <a href="/form/<%= report.report_id %>"
                       class="action-btn edit"
                       title="Modifier">
                       <i class="fa-solid fa-pen-to-square"></i>
                    </a>
                    <button class="action-btn delete"
                            data-report-id="<%= report.report_id %>"
                            title="Supprimer">
                      <i class="fas fa-trash"></i>
                    </button>
                  </div>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr>
              <td colspan="5" class="no-reports">
                <i class="fas fa-info-circle"></i>
                <p>Aucun rapport trouvé</p>
                <a href="/form" class="btn btn-primary mt-3">
                  <i class="fas fa-plus"></i>
                  Créer un nouveau rapport
                </a>
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <div class="dashboard-pagination" id="dashboardPagination" aria-label="Pagination des rapports">
      <div class="pagination-summary">
        <% if (pagination && pagination.totalReports > 0) { %>
          Rapports <strong><%= pagination.startItem %></strong> à <strong><%= pagination.endItem %></strong>
          sur <strong><%= pagination.totalReports %></strong>
        <% } else { %>
          Aucun rapport à afficher
        <% } %>
      </div>
      <% if (pagination && pagination.totalPages > 1) { %>
        <nav class="pagination-controls" aria-label="Navigation entre les pages de rapports">
          <a class="pagination-btn <%= pagination.hasPreviousPage ? '' : 'disabled' %>"
             href="/dashboard?page=<%= pagination.previousPage %>&search=<%= encodeURIComponent(typeof search !== 'undefined' ? search : '') %>"
             data-page="<%= pagination.previousPage %>"
             aria-label="Page précédente"
             <%= pagination.hasPreviousPage ? '' : 'aria-disabled="true" tabindex="-1"' %>>
            <i class="fas fa-chevron-left"></i>
            Précédent
          </a>
          <span class="pagination-current">
            Page <strong><%= pagination.currentPage %></strong> / <strong><%= pagination.totalPages %></strong>
          </span>
          <a class="pagination-btn <%= pagination.hasNextPage ? '' : 'disabled' %>"
             href="/dashboard?page=<%= pagination.nextPage %>&search=<%= encodeURIComponent(typeof search !== 'undefined' ? search : '') %>"
             data-page="<%= pagination.nextPage %>"
             aria-label="Page suivante"
             <%= pagination.hasNextPage ? '' : 'aria-disabled="true" tabindex="-1"' %>>
            Suivant
            <i class="fas fa-chevron-right"></i>
          </a>
        </nav>
      <% } %>
    </div>
  </section>

  <!-- Floating Action Button -->
  <a href="/form" class="fab-button" title="Créer un nouveau rapport">
    <i class="fas fa-plus"></i>
    <span>Nouveau rapport</span>
  </a>
</div>

<!-- Delete Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" role="dialog">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">
          <i class="fas fa-exclamation-triangle"></i>
          Confirmer la suppression
        </h5>
        <button type="button" class="close" data-dismiss="modal">
          <span>&times;</span>
        </button>
      </div>
      <div class="modal-body">
        Êtes-vous sûr de vouloir supprimer ce rapport ? Cette action est irréversible.
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-dismiss="modal">
          <i class="fas fa-times"></i> Annuler
        </button>
        <button type="button" class="btn btn-danger" id="confirmDeleteBtn">
          <i class="fas fa-trash"></i> Supprimer
        </button>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer', {
  showScripts: true,
  customScripts: ['/static/js/vehicleBrandLogos.js', '/static/js/dashboard.js']
}) %>