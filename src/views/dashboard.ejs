<%- include('partials/header', {
  title: 'Tableau de bord',
  showNav: true,
  currentPage: 'dashboard',
  isAdmin: user.role === 'admin'
}) %>

<div class="content-wrapper">
  <%
    const flashSuccess = typeof success !== 'undefined' && success
      ? (Array.isArray(success) ? success[0] : success)
      : (locals.success && locals.success.length ? locals.success[0] : null);
    const flashError = locals.error && locals.error.length ? locals.error[0] : null;
    const routeError = errors && errors.length
      ? (errors[0] === 'Error loading reports' ? 'Impossible de charger les rapports. Réessayez plus tard.' : errors[0])
      : null;
    const hasSearchQuery = typeof search !== 'undefined' && search && String(search).trim();
  %>
  <% if (routeError) { %>
    <div id="dashboardFeedback" class="alert alert-danger" role="alert" aria-live="polite">
      <i class="fas fa-exclamation-circle" aria-hidden="true"></i>
      <%= routeError %>
    </div>
  <% } else if (flashSuccess) { %>
    <div id="dashboardFeedback" class="alert alert-success fade-out" role="status" aria-live="polite">
      <i class="fas fa-check-circle" aria-hidden="true"></i>
      <%= flashSuccess %>
    </div>
  <% } else if (flashError) { %>
    <div id="dashboardFeedback" class="alert alert-danger fade-out" role="alert" aria-live="polite">
      <i class="fas fa-exclamation-circle" aria-hidden="true"></i>
      <%= flashError %>
    </div>
  <% } else { %>
    <div id="dashboardFeedback" class="d-none" aria-live="polite"></div>
  <% } %>

  <section class="reports-section">
    <div class="section-header">
      <h3><i class="fas fa-car" aria-hidden="true"></i> Liste des rapports</h3>
      <div class="header-actions">
        <div class="search-box">
          <label for="searchReports" class="sr-only">Rechercher un rapport</label>
          <i class="fas fa-search" aria-hidden="true"></i>
          <input type="search"
                 id="searchReports"
                 class="form-control"
                 placeholder="Plaque, client, marque…"
                 value="<%= typeof search !== 'undefined' ? search : '' %>"
                 autocomplete="off"
                 enterkeyhint="search">
        </div>
      </div>
    </div>

    <div class="table-responsive">
      <table class="reports-table">
        <thead>
          <tr>
            <th>
              <i class="fas fa-id-card"></i>
              Immatriculation
            </th>
            <th>
              <i class="fas fa-user"></i>
              Client
            </th>
            <th>
              <i class="fas fa-car"></i>
              Véhicule
            </th>
            <th>
              <i class="fas fa-calendar"></i>
              Date
            </th>
            <th>
              <i class="fas fa-cog"></i>
              Actions
            </th>
          </tr>
        </thead>
        <tbody>
          <% if (reports && reports.length > 0) { %>
            <% reports.forEach(function(report) { %>
              <tr class="report-row">
                <td class="license-plate"><%= report.license_plate %></td>
                <td><%= report.client_name %></td>
                <td>
                  <% const dashboardBrandLogo = getVehicleBrandLogo(report.brand); %>
                  <div class="vehicle-brand-cell">
                    <img src="<%= dashboardBrandLogo.src %>"
                         alt="<%= dashboardBrandLogo.alt %>"
                         class="vehicle-brand-logo vehicle-brand-logo-sm"
                         loading="lazy"
                         decoding="async">
                    <span><%= report.brand && report.model ? `${report.brand} ${report.model}` : 'N/A' %></span>
                  </div>
                </td>
                <td><%= new Date(report.created_at).toLocaleDateString('fr-FR') %></td>
                <td>
                  <div class="action-buttons">
                    <a href="/report/<%= report.report_id %>"
                       class="action-btn view"
                       title="Voir le rapport"
                       aria-label="Voir le rapport">
                      <i class="fas fa-eye" aria-hidden="true"></i>
                    </a>
                    <a href="/report/preview/<%= report.report_id %>"
                       class="action-btn preview"
                       title="Prévisualiser le PDF"
                       aria-label="Prévisualiser le PDF"
                       target="_blank"
                       rel="noopener noreferrer">
                      <i class="fas fa-file-pdf" aria-hidden="true"></i>
                    </a>
                    <a href="/report/download/<%= report.report_id %>"
                       class="action-btn download"
                       title="Télécharger le PDF"
                       aria-label="Télécharger le PDF">
                      <i class="fas fa-download" aria-hidden="true"></i>
                    </a>
                    <a href="/form/<%= report.report_id %>"
                       class="action-btn edit"
                       title="Modifier le rapport"
                       aria-label="Modifier le rapport">
                      <i class="fas fa-pen-to-square" aria-hidden="true"></i>
                    </a>
                    <button type="button"
                            class="action-btn delete"
                            data-report-id="<%= report.report_id %>"
                            title="Supprimer le rapport"
                            aria-label="Supprimer le rapport">
                      <i class="fas fa-trash" aria-hidden="true"></i>
                    </button>
                  </div>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr>
              <td colspan="5" class="no-reports">
                <i class="fas fa-info-circle" aria-hidden="true"></i>
                <% if (hasSearchQuery) { %>
                  <p>Aucun résultat pour «&nbsp;<%= search %>&nbsp;»</p>
                  <p class="text-muted small mb-0">Modifiez votre recherche ou effacez le champ pour tout afficher.</p>
                <% } else { %>
                  <p>Aucun rapport pour le moment</p>
                  <a href="/form" class="btn btn-primary mt-3">
                    <i class="fas fa-plus" aria-hidden="true"></i>
                    Créer un rapport
                  </a>
                <% } %>
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <div class="dashboard-pagination<%= pagination && pagination.totalPages <= 1 ? ' dashboard-pagination--single-page' : '' %>" id="dashboardPagination" aria-label="Pagination des rapports"></div>
    <script type="application/json" id="dashboardInitialPagination"><%- JSON.stringify(pagination || {}) %></script>
  </section>

  <!-- Floating Action Button -->
  <a href="/form" class="fab-button" title="Créer un rapport" aria-label="Créer un rapport">
    <i class="fas fa-plus" aria-hidden="true"></i>
    <span>Nouveau rapport</span>
  </a>
</div>

<div class="modal fade" id="deleteModal" tabindex="-1" role="dialog" aria-labelledby="deleteModalTitle" aria-modal="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="deleteModalTitle">
          <i class="fas fa-exclamation-triangle" aria-hidden="true"></i>
          Confirmer la suppression
        </h5>
        <button type="button" class="close" data-dismiss="modal" aria-label="Fermer">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <div class="modal-body">
        Êtes-vous sûr de vouloir supprimer ce rapport ? Cette action est irréversible.
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-dismiss="modal">
          <i class="fas fa-times"></i> Annuler
        </button>
        <button type="button" class="btn btn-danger" id="confirmDeleteBtn">
          <i class="fas fa-trash"></i> Supprimer
        </button>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer', {
  showScripts: true,
  customScripts: ['/static/js/vehicleBrandLogos.js', '/static/js/pagination-ui.js', '/static/js/dashboard.js']
}) %>