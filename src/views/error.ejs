<%
  const feedbackMessage = typeof message !== 'undefined' && message
    ? message
    : (typeof error !== 'undefined' && error
      ? (Array.isArray(error) ? error[0] : error)
      : null);
  const hasUser = typeof user !== 'undefined' && user;
%>
<%- include('partials/header', {
  title: 'Erreur',
  showNav: hasUser,
  currentPage: 'error',
  isAdmin: hasUser && user.role === 'admin',
  authPage: !hasUser,
  bodyClass: 'app-body'
}) %>

<div class="row justify-content-center">
  <div class="col-md-8 col-lg-6">
    <div class="card shadow">
      <div class="card-header bg-danger text-white text-center">
        <i class="fas fa-exclamation-circle fa-2x mb-2" aria-hidden="true"></i>
        <h1 class="h4 mb-0">Erreur</h1>
      </div>
      <div class="card-body text-center">
        <% if (feedbackMessage) { %>
          <div class="alert alert-danger text-left" role="alert" aria-live="polite">
            <i class="fas fa-exclamation-circle" aria-hidden="true"></i>
            <%= feedbackMessage %>
          </div>
        <% } %>
        <a href="<%= hasUser ? '/dashboard' : '/auth/login' %>" class="btn btn-primary">
          <i class="fas fa-arrow-left" aria-hidden="true"></i>
          <%= hasUser ? 'Retour au tableau de bord' : 'Retour à la connexion' %>
        </a>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer', {
  showScripts: false,
  customScripts: []
}) %>
