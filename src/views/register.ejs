<%- include('partials/header', {
  title: 'Inscription',
  showNav: false,
  currentPage: 'register',
  authPage: true,
  bodyClass: 'app-body'
}) %>

<div class="row justify-content-center">
  <div class="col-md-6">
    <div class="card shadow">
      <div class="card-header bg-primary text-white text-center">
        <img src="/static/img/company_logo.png" alt="<%= process.env.COMPANY_NAME %> Logo" class="mb-3 header-logo" style="max-width: 150px;">
        <h1 class="h4 mb-0">Inscription</h1>
      </div>
      <div class="card-body">
        <% if (error) { %>
          <div class="alert alert-danger" role="alert" aria-live="polite">
            <i class="fas fa-exclamation-circle" aria-hidden="true"></i>
            <%= Array.isArray(error) ? error[0] : error %>
          </div>
        <% } %>
        <form action="/register" method="post">
          <div class="form-group">
            <label for="username">
              <i class="fas fa-user" aria-hidden="true"></i> Nom d'utilisateur
            </label>
            <input type="text" class="form-control" id="username" name="username" required autocomplete="username">
          </div>
          <div class="form-group">
            <label for="password">
              <i class="fas fa-lock" aria-hidden="true"></i> Mot de passe
            </label>
            <input type="password" class="form-control" id="password" name="password" required autocomplete="new-password">
          </div>
          <button type="submit" class="btn btn-primary btn-block">
            <i class="fas fa-user-plus" aria-hidden="true"></i> S'inscrire
          </button>
          <div class="text-center mt-3">
            <a href="/auth/login" class="text-muted">
              <i class="fas fa-arrow-left" aria-hidden="true"></i> Retour à la connexion
            </a>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer', {
  showScripts: false,
  customScripts: []
}) %>
